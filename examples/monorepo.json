{
  "version": 1,
  "projects": [
    { "id": "core", "root": "packages/core", "inputs": ["tooling/typescript/"] },
    { "id": "ui", "root": "packages/ui", "dependsOn": ["core"] },
    { "id": "api", "root": "apps/api", "dependsOn": ["core"] },
